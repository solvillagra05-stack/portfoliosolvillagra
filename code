<script>
const cur=document.getElementById('cur');
document.addEventListener('mousemove',e=>{cur.style.left=e.clientX+'px';cur.style.top=e.clientY+'px'});
document.querySelectorAll('a,button,.pcard,[onclick],.sw-chip,.chip').forEach(el=>{
  el.addEventListener('mouseenter',()=>cur.classList.add('big'));
  el.addEventListener('mouseleave',()=>cur.classList.remove('big'));
});
const nav=document.getElementById('nav');
window.addEventListener('scroll',()=>{
  nav.classList.toggle('scrolled',window.scrollY>60);
  let c='';
  document.querySelectorAll('section[id]').forEach(s=>{if(window.scrollY>=s.offsetTop-200)c=s.id});
  document.querySelectorAll('.nav-links a').forEach(a=>a.classList.toggle('on',a.getAttribute('href')==='#'+c));
});
const io=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}});
},{threshold:0.1,rootMargin:'0px 0px -50px 0px'});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
window.addEventListener('scroll',()=>{
  const y=window.scrollY;
  if(y<window.innerHeight)document.querySelector('.h-left').style.transform=`translateY(${y*.18}px)`;
});
function openFicha(){const o=document.getElementById('ov');o.classList.add('on');o.scrollTop=0;document.body.style.overflow='hidden'}
function closeFicha(){document.getElementById('ov').classList.remove('on');document.body.style.overflow=''}
function openLoft(){const o=document.getElementById('ov-loft');o.classList.add('on');o.scrollTop=0;document.body.style.overflow='hidden'}
function closeLoft(){document.getElementById('ov-loft').classList.remove('on');document.body.style.overflow=''}
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeFicha();closeLoft()}});

async function enviarForm(e) {
  e.preventDefault();
  const FORMSPREE = 'https://formspree.io/f/REEMPLAZAR_CON_TU_CODIGO';
  const nombre  = document.querySelector('.ct-inp[placeholder="Tu nombre"]').value;
  const email   = document.querySelector('.ct-inp[type="email"]').value;
  const asunto  = document.querySelector('.ct-inp[placeholder="Colaboración, consulta..."]').value;
  const mensaje = document.querySelector('.ct-ta').value;
  if (!nombre || !email || !mensaje) {
    document.getElementById('form-err').style.display = 'block';
    document.getElementById('form-err').textContent = 'Completá nombre, email y mensaje.';
    return;
  }
  const btn = e.target;
  btn.textContent = 'Enviando...';
  btn.style.opacity = '.6';
  try {
    const res = await fetch(FORMSPREE, {
      method: 'POST',
      headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
      body: JSON.stringify({nombre, email, asunto, mensaje})
    });
    if (res.ok) {
      document.getElementById('form-msg').style.display = 'block';
      document.getElementById('form-err').style.display = 'none';
      btn.textContent = '¡Enviado!';
    } else {
      throw new Error();
    }
  } catch {
    document.getElementById('form-err').style.display = 'block';
    document.getElementById('form-err').textContent = 'Hubo un error. Escribime a solvillagra05@gmail.com';
    btn.textContent = 'Enviar mensaje';
    btn.style.opacity = '1';
  }
}
</script>
